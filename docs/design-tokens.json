{
  "name": "ClinicFlow Design Tokens",
  "version": "1.0.0",
  "direction": "rtl",
  "typography": {
    "fontFamily": "Cairo, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "colors": {
    "primary": {
      "DEFAULT": "#1769E8",
      "hover": "#0F56C8",
      "light": "#EBF2FE",
      "focus": "rgba(23, 105, 232, 0.25)"
    },
    "navy": {
      "sidebar": "#102B55",
      "sidebarActive": "#1A3E75",
      "deep": "#0B1F3A"
    },
    "background": {
      "app": "#F4F7FC",
      "surface": "#FFFFFF",
      "subtle": "#F8FAFD",
      "input": "#FFFFFF"
    },
    "text": {
      "primary": "#172B4D",
      "secondary": "#718096",
      "muted": "#A0AEC0",
      "inverse": "#FFFFFF"
    },
    "border": {
      "DEFAULT": "#E4EAF3",
      "subtle": "#EDF2F7",
      "strong": "#CBD5E1"
    },
    "feedback": {
      "success": {
        "DEFAULT": "#159A72",
        "light": "#E8F8F3",
        "border": "#A7E3D0"
      },
      "warning": {
        "DEFAULT": "#E99A20",
        "light": "#FEF7EB",
        "border": "#FBD9A3"
      },
      "danger": {
        "DEFAULT": "#DC5353",
        "light": "#FDF1F1",
        "border": "#F7B8B8"
      },
      "info": {
        "DEFAULT": "#1769E8",
        "light": "#EBF2FE",
        "border": "#B9D5FA"
      }
    }
  },
  "radii": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.25rem",
    "full": "9999px"
  },
  "shadows": {
    "card": "0 2px 8px -2px rgba(16, 43, 85, 0.06), 0 1px 4px -1px rgba(16, 43, 85, 0.04)",
    "cardHover": "0 8px 20px -4px rgba(16, 43, 85, 0.1), 0 4px 8px -2px rgba(16, 43, 85, 0.05)",
    "dropdown": "0 10px 25px -5px rgba(16, 43, 85, 0.12), 0 8px 10px -6px rgba(16, 43, 85, 0.08)"
  }
}

